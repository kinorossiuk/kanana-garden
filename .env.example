# Copy to .env. This file contains workstation-side defaults only.
# Do not commit the copied .env file.
KANANA_BASE_URL=http://5600g.local:8000/v1
KANANA_API_KEY=replace-with-a-long-random-token

# Leave empty when exactly one authorized ADB device is connected.
ANDROID_SERIAL=

GITHUB_REPOSITORY=kinorossiuk/kanana-garden

# OTA_DOWNLOAD_URL and OTA_SHA256 must come from independently verified
# vendor release information. OTA binaries are stored under ignored var/ota/.
OTA_VERSION=
OTA_DOWNLOAD_URL=
OTA_SHA256=
