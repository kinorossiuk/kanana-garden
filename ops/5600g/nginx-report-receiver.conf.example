# Copy to /etc/nginx/sites-available/kanana-report-receiver after replacing
# YOUR_SUBDOMAIN. This example uses 8443 so an existing 443 virtual host or
# router administration port is not overwritten.
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name YOUR_SUBDOMAIN.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_SUBDOMAIN.duckdns.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 64k;

    location = /health {
        proxy_pass http://127.0.0.1:8762;
        proxy_set_header Host $host;
    }

    location = /v1/uis7862s/reports {
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:8762;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    location / {
        return 404;
    }
}
