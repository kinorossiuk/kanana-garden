# Copy to ~/.config/kanana-garden/server.env on the 5600G host.
KANANA_REPO_DIR=/home/USER/kanana
KANANA_SERVER_HOST=0.0.0.0
KANANA_SERVER_PORT=8000
KANANA_SERVER_THREADS=6
KANANA_SERVER_DTYPE=float32
KANANA_MAX_INPUT_TOKENS=2048
KANANA_MAX_OUTPUT_TOKENS=512
KANANA_API_KEY=replace-with-a-long-random-token
HF_HOME=/home/USER/.cache/huggingface
